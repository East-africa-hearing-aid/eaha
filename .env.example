# Web3Forms access key for the booking form (app/book/BookContent.tsx).
# Create one at https://web3forms.com with the inbox that should receive
# appointment requests (info@eahac.com). The key is public by design.
#
# NEXT_PUBLIC_* variables are inlined at BUILD time, so after adding this to
# Vercel (Project > Settings > Environment Variables) you must redeploy.
NEXT_PUBLIC_WEB3FORMS_KEY=
