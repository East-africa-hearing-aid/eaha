# Optional override for the booking form's Web3Forms access key
# (app/book/BookContent.tsx). The default key in the code delivers to
# info@eahac.com. The key is public by design.
#
# NEXT_PUBLIC_* variables are inlined at BUILD time, so after changing this in
# Vercel (Project > Settings > Environment Variables) you must redeploy.
NEXT_PUBLIC_WEB3FORMS_KEY=
